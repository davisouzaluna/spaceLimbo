# Copie para .env e preencha
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# ID do seu servidor de testes: comandos aparecem na hora (deixe vazio para registrar globalmente)
DEV_GUILD_ID=

# Painel web
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
PANEL_TOKEN=troque-esta-senha
# PANEL_URL=http://127.0.0.1:8080

# Opcional: caminho de um FFmpeg próprio. Vazio = FFmpeg do sistema ou o embutido (imageio-ffmpeg)
FFMPEG_PATH=
DEFAULT_VOLUME=0.5
IDLE_TIMEOUT=300
